   ]
  },
  {
   "id": "sc2",
   "stage": "cut",
   "title": "Cut the strip",
   "text": "Cut one strip 10 × 50 cm. The direction doesn't matter much for a scrunchie, so place it wherever it fits your scrap.",
   "visual": {
    "type": "layout",
    "materialId": "main"
   },
   "pieces": [
    "tube"
   ],
   "warnings": [
    "Cut away from your body and keep fingers clear of the blades."
   ]
  },
  {
   "id": "sc3",
   "stage": "sew",
   "title": "Sew the tube",
   "text": "Fold the strip in half lengthwise, right sides together. Sew the long edge with a 1 cm seam, leaving both short ends open. Turn right side out with a safety pin.",
   "visual": {
    "type": "template",
    "name": "tube",
    "args": {
     "tone": "main",
     "label": "sew the long edge, turn right side out"
    }
   },
   "beginner": "By hand, use a small backstitch (about 3 mm stitches) — it's as strong as machine stitching. Attach a safety pin to one end and work it through the tube to turn it.",
   "measurements": [
    {
     "label": "Seam allowance",
     "value": "sa",
     "unit": "len"
    }
   ],
   "pieces": [
    "tube"
   ],
   "techniques": [
    "seam-allowance",
    "backstitching"
   ]
  },
  {
   "id": "sc4",
   "stage": "assemble",
   "title": "Thread the elastic",
   "text": "Cut 20 cm of elastic. Pin a safety pin to one end and feed it through the tube. Pin the trailing end to the tube so it can't slip inside.",
   "visual": {
    "type": "template",
    "name": "cord",
    "args": {
     "tone": "main",
     "label": "elastic through the tube"
    }
   },
   "measurements": [
