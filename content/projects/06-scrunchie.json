   ],
   "techniques": [
    "elastic-waistband"
   ]
  },
  {
   "id": "sc5",
   "stage": "assemble",
   "title": "Join the elastic",
   "text": "Check the elastic isn't twisted. Overlap the ends by 1.5 cm and zigzag back and forth several times, or hand-stitch firmly through both layers.",
   "visual": {
    "type": "template",
    "name": "elastic",
    "args": {
     "overlap": 1.5
    }
   },
   "measurements": [
    {
     "label": "Overlap",
     "value": 1.5,
     "unit": "len"
    }
   ],
   "techniques": [
    "zigzag-stitch"
   ]
  },
  {
   "id": "sc6",
   "stage": "finish",
   "title": "Close the ring",
   "text": "Fold 1 cm of one tube end to the inside. Tuck the other raw end into it by 1 cm and slip-stitch all the way round to join the tube into a ring.",
   "visual": {
    "type": "template",
    "name": "close",
