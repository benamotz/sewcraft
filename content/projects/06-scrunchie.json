 "steps": [
  {
   "id": "sc1",
   "stage": "prep",
   "title": "Press your fabric",
   "text": "Press the fabric smooth. Lightweight fabrics like lawn, rayon or satin gather softly; quilting cotton gives a fuller, puffier scrunchie.",
   "visual": {
    "type": "template",
    "name": "press",
    "args": {
