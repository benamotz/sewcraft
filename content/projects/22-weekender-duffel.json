   ],
   "techniques": [
    "seam-allowance",
    "clipping-corners"
   ],
   "warnings": [
    "Open the zipper before sewing the second end, or you can't turn the bag."
   ]
  },
  {
   "id": "w10",
   "stage": "assemble",
   "title": "Turn and shape",
   "text": "Trim the corners, turn right side out through the zipper and push out the corners.",
