  {
   "id": "w8",
   "stage": "assemble",
   "title": "Make the main tube",
   "text": "Sew the long raw edges of the zipper unit to the top edges of the body, right sides together, with 1 cm seams, forming a tube. Topstitch the seams 5 mm towards the body.",
   "visual": {
    "type": "template",
    "name": "sew",
    "args": {
