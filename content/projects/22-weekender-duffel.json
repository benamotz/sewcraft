  {
   "id": "w9",
   "stage": "assemble",
   "title": "Sew in the end panels",
   "text": "OPEN THE ZIPPER halfway. Mark the corners of each end panel 1 cm in. Clip the tube's seam allowance at the corresponding points. Sew each end panel into the tube right sides together, stopping with the needle down at each corner, pivoting and continuing.",
   "visual": {
    "type": "template",
    "name": "sew",
    "args": {
     "tone": "main",
     "sides": "ltrb",
     "label": "end panel into the tube · pivot at corners"
    }
   },
   "beginner": "Pivoting means stopping exactly at the corner mark with the needle down, lifting the foot, turning the work 90° and carrying on. Clipping the tube's allowance at the corners lets it turn the corner flat.",
   "measurements": [
    {
     "label": "Seam allowance",
     "value": "sa",
     "unit": "len"
    }
   ],
