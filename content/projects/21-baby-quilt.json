  },
  {
   "id": "q3",
   "stage": "cut",
   "title": "Cut squares B",
   "text": "Cut 24 squares of print B.",
   "visual": {
    "type": "layout",
    "materialId": "printB"
   },
   "pieces": [
    "sqB"
   ]
  },
  {
   "id": "q4",
   "stage": "cut",
   "title": "Cut backing and batting",
   "text": "Cut the backing and batting 5 cm larger than the quilt top on every side.",
   "visual": {
    "type": "layout",
    "materialId": "backing"
   },
   "pieces": [
    "backp"
   ]
  },
  {
   "id": "q5",
   "stage": "cut",
   "title": "Cut the batting",
   "text": "Cut the batting the same size as the backing.",
   "visual": {
    "type": "layout",
    "materialId": "batt"
   },
   "pieces": [
    "battp"
   ]
  },
  {
   "id": "q6",
   "stage": "cut",
   "title": "Cut binding strips",
   "text": "Cut three binding strips across the width of the fabric.",
   "visual": {
    "type": "layout",
    "materialId": "bind"
   },
   "pieces": [
    "bindp"
   ]
  },
  {
   "id": "q7",
   "stage": "sew",
   "title": "Arrange the squares",
   "text": "Lay out 8 rows of 6 squares in a checkerboard, alternating A and B. Photograph the layout so you can find your place.",
   "visual": {
    "type": "template",
    "name": "patchwork",
    "args": {
     "tones": [
      "printA",
      "printB"
     ],
     "cols": 6,
     "rows": 8,
     "sewn": false
    }
   },
   "pieces": [
    "sqA",
    "sqB"
   ]
  },
  {
   "id": "q8",
   "stage": "sew",
   "title": "Sew the rows",
   "text": "Sew the squares of each row together with a 0.75 cm seam. Press seams of odd rows to the left and even rows to the right.",
   "visual": {
    "type": "template",
    "name": "patchwork",
    "args": {
     "tones": [
      "printA",
      "printB"
     ],
     "cols": 6,
     "rows": 8,
     "sewn": false
    }
   },
   "beginner": "Alternating the pressing direction lets the seams 'nest' — they lock together when you join the rows, so the corners match.",
   "measurements": [
    {
     "label": "Seam allowance",
     "value": "sa",
     "unit": "len"
    }
   ],
   "pieces": [
    "sqA",
    "sqB"
   ],
   "techniques": [
    "seam-allowance",
    "pressing"
   ]
  },
  {
   "id": "q9",
   "stage": "sew",
   "title": "Join the rows",
   "text": "Sew the rows together, nesting the seams and pinning at every intersection. Press the long seams in one direction.",
   "visual": {
    "type": "template",
    "name": "patchwork",
    "args": {
     "tones": [
      "printA",
      "printB"
     ],
     "cols": 6,
     "rows": 8,
     "sewn": true
    }
   },
   "measurements": [
    {
     "label": "Seam allowance",
     "value": "sa",
     "unit": "len"
    }
   ],
   "pieces": [
    "sqA",
    "sqB"
   ]
  },
  {
   "id": "q10",
   "stage": "assemble",
   "title": "Make the quilt sandwich",
   "text": "Tape the backing to the floor wrong side up, smooth the batting on top, then the quilt top right side up. Pin every 10 cm with safety pins.",
