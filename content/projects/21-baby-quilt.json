   ],
   "techniques": [
    "quilting"
   ]
  },
  {
   "id": "q11",
   "stage": "assemble",
   "title": "Quilt",
   "text": "Quilt straight lines 5 mm either side of every seam ('stitch in the ditch' or just beside it), working from the centre out with a walking foot.",
   "visual": {
